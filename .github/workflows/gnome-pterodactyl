          echo -e "${C_YELLOW}[INFO] Setting APP_URL=$PANEL_URL ...${C_NC}"
          sudo sed -i "s|^APP_URL=.*|APP_URL=$PANEL_URL|" /var/www/pterodactyl/.env
          sudo -H -u www-data php /var/www/pterodactyl/artisan config:clear
          sudo -H -u www-data php /var/www/pterodactyl/artisan cache:clear
          sudo systemctl restart pteroq

          echo "::group::PTERO VERIFY"
          curl -s -o /dev/null -w "panel($PANEL_URL) /auth/login -> HTTP %{http_code}\n" "$PANEL_URL/auth/login"
          curl -s -o /dev/null -w "wings($WINGS_URL) /api/servers -> HTTP %{http_code} (401 = ok, butuh token)\n" "$WINGS_URL/api/servers"
          echo "--- OPTIONS preflight CORS:"
          curl -s -D - -o /dev/null -X OPTIONS -H "Origin: $PANEL_URL" "$WINGS_URL/api/servers" | grep -i '^access-control-allow-origin' || echo "ko"
          n=$(sudo journalctl -u wings --no-pager -n 300 2>/dev/null | grep -c "request origin not allowed" || true)
          echo "wings 'request origin not allowed' (300 baris terakhir): $n"
          echo "::endgroup::"

          echo -e "${C_YELLOW}[INFO] Writing helper pt-status + info + desktop...${C_NC}"
          sudo tee /usr/local/bin/pt-status >/dev/null <<'SH'
          #!/usr/bin/env bash
          PANEL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/cf-panel.log 2>/dev/null | tail -1)
          WINGS=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/cf-wings.log 2>/dev/null | tail -1)
          echo "======================================"
          echo "  PTERODACTYL STATUS"
          echo "======================================"
          echo "Panel UI : ${PANEL:-<tunnel tidak ditemukan>}"
          echo "Wings    : ${WINGS:-<tunnel tidak ditemukan>}"
          echo "--------------------------------------"
          echo "Admin    : admin@pterodactyl.test / AdminPass123"
          echo "Demo     : demo@example.test / Demo1234"
          echo "--------------------------------------"
          echo "CATATAN:"
          echo "- Panel 1.15.1 TIDAK punya self-registration."
          echo "  Admin buat akun: Admin -> Users -> New User."
          echo "- URL tunnel BERUBAH tiap cloudflared restart."
          echo "  Kalau berubah, jalankan skrip ini lagi."
          SH
          sudo chmod +x /usr/local/bin/pt-status

          cat > /home/runner/pterodactyl-info.txt <<EOF
          PTERODACTYL PANEL + WINGS (setup otomatis)
