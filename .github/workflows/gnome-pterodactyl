              'ghcr.io/parkervcp/yolks:nodejs_22',
              'ghcr.io/parkervcp/yolks:nodejs_21',
              'ghcr.io/parkervcp/yolks:nodejs_20',
              'ghcr.io/parkervcp/yolks:nodejs_19',
              'ghcr.io/parkervcp/yolks:nodejs_18',
          ];
          $egg->save();
          echo 'egg_id=' . $egg->id . ' nest_id=' . $nestId . PHP_EOL;
          PHP
          sudo -H -u www-data env XDG_CONFIG_HOME=/tmp/psysh php /var/www/pterodactyl/artisan tinker --execute="$(cat /tmp/tinker_import.php)"

          echo -e "${C_YELLOW}[INFO] Creating demo user (non-admin)...${C_NC}"
          API_KEY=${API_KEY:-UNSET}
          if [ "$API_KEY" != "UNSET" ]; then
            curl -sf -o /dev/null -X POST http://127.0.0.1/api/application/users \
              -H "Authorization: Bearer $API_KEY" -H 'Accept: application/json' -H 'Content-Type: application/json' \
              -d '{"email":"demo@example.test","username":"demo","first_name":"Demo","last_name":"User","password":"Demo1234","language":"en","root_admin":false}' || true
            echo -e "${C_GREEN}[INFO] User demo@example.test / Demo1234 dibuat (email notification gagal = wajar).${C_NC}"
          fi
          echo -e "${C_GREEN}[OK] PTERO 5 done.${C_NC}"

      - name: "PTERO 6/6 Finalize + Verify + Helper"
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[PTERO 6/6] FINALIZE + VERIFY + HELPER${C_NC}"
          echo "------------------------------------------------------------"

