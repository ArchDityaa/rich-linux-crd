name: beta gnome

on:
  workflow_dispatch:
    inputs:
      crd_host_command:
        description: "Paste SELURUH command Chrome Remote Desktop dari halaman Remote Access"
        required: true
        type: string

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 360

    steps:

      # ============================================================
      # VM SPEC CHECK (10 DETIK UNTUK MEMUTUSKAN)
      # Tampilkan spesifikasi runner di PALING AWAL. User diberi jeda
      # 10 detik: kalau spesifikasi sesuai, biarkan lanjut. Kalau tidak
      # sesuai, CANCEL workflow di UI GitHub sebelum timeout.
      # ============================================================
      - name: VM Spec Check (30s to cancel)
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'
          CORE_COUNT=$(nproc)
          CPU_MODEL=$(grep '^model name' /proc/cpuinfo | head -n1 | sed 's/.*: //' || echo '?')
          RAM_TOTAL=$(free -h | awk 'NR==2 {print $2}')
          DISK_FREE=$(df -h / | awk 'NR==2 {print $4}')
          UNAME=$(uname -r)

          echo ""
          echo "=============================================================="
          echo -e "${C_CYAN}            VM SPECIFICATION (GitHub runner)${C_NC}"
          echo "=============================================================="
          echo -e "  ${C_YELLOW}CPU     :${C_NC} $CPU_MODEL"
          echo -e "  ${C_YELLOW}Cores   :${C_NC} $CORE_COUNT (threads)"
          echo -e "  ${C_YELLOW}RAM     :${C_NC} $RAM_TOTAL"
          echo -e "  ${C_YELLOW}Disk    :${C_NC} ${DISK_FREE} free"
          echo -e "  ${C_YELLOW}Kernel  :${C_NC} $UNAME"
          echo "=============================================================="
          echo -e "${C_GREEN}[INFO] Jika spesifikasi ini sesuai, biarkan lanjut.${C_NC}"
          echo -e "${C_RED}[INFO] Jika TIDAK sesuai, CANCEL workflow sekarang (10 detik).${C_NC}"
          echo "=============================================================="
          echo ""
          sleep 30
          echo -e "${C_GREEN}[OK] Lanjut instalasi (spesifikasi disetujui / tidak di-cancel).${C_NC}"

      - name: Checkout repository (for safe-upgrade helper)
        uses: actions/checkout@v4

      - id: dated
        run: echo "today=$(date +'%Y%m%d')" >> "$GITHUB_OUTPUT"

      - name: Restore apt package cache (re-run cepat, tak unduh ulang ~GB)
        uses: actions/cache@v4
        with:
          path: |
            /home/runner/apt-archives
            /var/lib/apt/lists
          key: apt-ubuntu-2404-gnome2-${{ steps.dated.outputs.today }}
          restore-keys: |
            apt-ubuntu-2404-gnome2-
            apt-ubuntu-2404-
          save-always: true

      # ============================================================
      # PREPARE SYSTEM
      # ============================================================
      - name: Prepare System
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 01/16] PREPARE SYSTEM${C_NC}"
          echo "------------------------------------------------------------"

          __prepare_start=$(date +%s)

          echo -e "${C_YELLOW}[INFO] Disabling needrestart entirely (no noisy logs, no auto-restart)...${C_NC}"
          # Matikan apt hook needrestart SEBELUM operasi apt apa pun, supaya
          # setiap install/upgrade tidak menampilkan 'Scanning processes...'
          # dan tidak mencoba me-restart service (yang bisa memutus sesi CRD).
          # Di Ubuntu 24.04 hook asli needrestart ada di 99needrestart
          # (memanggil /usr/lib/needrestart/apt-pinvoke), bukan 20needrestart
          # (nama legacy 22.04). Hapus keduanya supaya tidak ada banner
          # "Scanning processes..." setelah setiap apt install/upgrade,
          # termasuk dari terminal sesi CRD.
          sudo rm -f /etc/apt/apt.conf.d/99needrestart || true
          sudo rm -f /etc/apt/apt.conf.d/20needrestart || true
          sudo mkdir -p /etc/needrestart/needrestart.conf.d || true
          echo '$nrconf{restart} = '"'"'l'"'"';' | sudo tee /etc/needrestart/needrestart.conf.d/99-no-restart.conf > /dev/null
          echo '$nrconf{kernelhints} = 0;' | sudo tee -a /etc/needrestart/needrestart.conf.d/99-no-restart.conf > /dev/null
          echo '$nrconf{check} = 0;' | sudo tee -a /etc/needrestart/needrestart.conf.d/99-no-restart.conf > /dev/null

          echo -e "${C_YELLOW}[INFO] Tuning apt for speed (retries, pipelining, minimal index languages)...${C_NC}"
          sudo tee /etc/apt/apt.conf.d/99-speed > /dev/null <<'APTEOF'
          Acquire::Retries "5";
          Acquire::http::Timeout "60";
          Acquire::http::Pipeline-Depth "10";
          Acquire::Languages "none";
          APTEOF

          # Pakai .deb dari cache GitHub (jika ada) agar upgrade/install
          # tidak mengunduh ulang (hemat ~GB saat re-run setelah gagal register).
          echo -e "${C_YELLOW}[INFO] Seeding /var/cache/apt/archives from GitHub apt cache...${C_NC}"
          sudo mkdir -p /var/cache/apt/archives/partial
          sudo cp -a /home/runner/apt-archives/. /var/cache/apt/archives/ 2>/dev/null || true

          # ============================================================
          # REPO VS CODE + CRD DI-SETUP DI SINI (SEBELUM update) sehingga
          # CUKUP SATU `apt-get update` untuk base + vscode + crd.
          # Steps 05 (VS Code) & 07 (CRD) tidak perlu apt-get update lagi
          # -> hemat ~2x update + lebih tahan terhadap hang update.
          # ============================================================
          echo -e "${C_YELLOW}[INFO] Setting up VS Code + CRD repositories (single apt-get update)...${C_NC}"
          sudo mkdir -p /etc/apt/keyrings

          echo -e "${C_YELLOW}[INFO]   Microsoft key (VS Code)...${C_NC}"
          if [ -s /tmp/packages.microsoft.gpg ]; then
            sudo cp /tmp/packages.microsoft.gpg /etc/apt/keyrings/packages.microsoft.gpg
          else
            wget -qO- https://packages.microsoft.com/keys/microsoft.asc \
              | gpg --dearmor \
              | sudo tee /etc/apt/keyrings/packages.microsoft.gpg > /dev/null
          fi
          echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
            | sudo tee /etc/apt/sources.list.d/vscode.list > /dev/null

          echo -e "${C_YELLOW}[INFO]   Google key (Chrome Remote Desktop)...${C_NC}"
          if [ -s /tmp/linux_signing_key.pub ]; then
            gpg --dearmor < /tmp/linux_signing_key.pub \
              | sudo tee /etc/apt/keyrings/google-linux.gpg > /dev/null
          else
            wget -qO- https://dl.google.com/linux/linux_signing_key.pub \
              | gpg --dearmor \
              | sudo tee /etc/apt/keyrings/google-linux.gpg > /dev/null
          fi
          echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-linux.gpg] http://dl.google.com/linux/chrome-remote-desktop/deb/ stable main" \
            | sudo tee /etc/apt/sources.list.d/chrome-remote-desktop.list > /dev/null

          echo -e "${C_YELLOW}[INFO] Updating package lists (SATU update utk base + vscode + crd)...${C_NC}"
          sudo apt-get update

          # eatmydata: wrapper apt/dpkg yang membuang SEMUA fsync (termasuk di
          # maintainer script postinst). --force-unsafe-io hanya mematikan fsync
          # saat unpack dpkg; eatmydata menjangkau lebih jauh -> install ~2GB
          # GNOME jauh lebih cepat. Aman di runner ephemeral (data tak perlu
          # durabel; bila runner crash, build diulang dari awal).
          echo -e "${C_YELLOW}[INFO] Installing eatmydata (fsync-free apt wrapper)...${C_NC}"
          sudo apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" -o Dpkg::Options::="--force-unsafe-io" -o Dpkg::Use-Pty=0 eatmydata

          echo -e "${C_YELLOW}[INFO] Removing unnecessary packages...${C_NC}"
          sudo eatmydata apt-get remove -y --purge \
            man-db \
            firewalld \
            ufw \
            || true

          sudo eatmydata apt-get autoremove -y || true

          # ============================================================
          # HAPUS SNAP PALING AWAL (sebelum upgrade/install apt apa pun).
          # Firewall terakhir: pin + purge + hold keliru bisa jadi bocor —
          # deb transisi firefox/thunderbird (1snap1) punya postinst yang
          # memaksa 'snap install firefox' + retry ke store (hang 30 menit)
          # SELAMA unpack dpkg. Karena itu snapd + transisi di-purge & di-hold
          # DI SINI, sebelum full upgrade, supaya tak pernah ter-unpack.
          # ============================================================
          echo -e "${C_YELLOW}[INFO] Purge snapd + firefox/thunderbird transitional EARLY (sebelum upgrade/install)...${C_NC}"
          sudo tee /etc/apt/preferences.d/99-no-snap.pref > /dev/null <<'PREFE'
          Package: snapd thunderbird firefox
          Pin: version *
          Pin-Priority: -10
          PREFE

          sudo eatmydata apt-get purge -y snapd firefox thunderbird || true
          sudo apt-mark hold snapd firefox thunderbird 2>/dev/null || true
          sudo rm -rf /snap /var/snap /var/lib/snapd /root/snap /home/runner/snap 2>/dev/null || true
          command -v snap >/dev/null 2>&1 && echo -e "${C_YELLOW}[WARN] snap masih ada.${C_NC}" || echo -e "${C_GREEN}[OK] snap dihapus permanen (sebelum apt upgrade).${C_NC}"

          # Full upgrade di BUILD-TIME (aman, sebelum CRD/session jalan).
          # Jangan `apt upgrade` manual dari dalam sesi CRD — itu me-restart
          # chrome-remote-desktop/gnome-shell/systemd dan memutus sesi.
          # Untuk upgrade dari dalam sesi, pakai `safe-upgrade` (scripts/safe-upgrade.sh).
          echo -e "${C_YELLOW}[INFO] Full upgrade at build-time (fast unpack, no dpkg fsync)...${C_NC}"
          sudo NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive eatmydata apt-get upgrade -y \
            -o Dpkg::Options::="--force-unsafe-io" \
            -o Dpkg::Use-Pty=0

          __prepare_end=$(date +%s)
          echo -e "${C_GREEN}[OK] System prepared. (Elapsed: $((__prepare_end-__prepare_start))s)${C_NC}"


      # ============================================================
      # INSTALL GNOME
      # ============================================================
      - name: Install GNOME Desktop
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'
          export DEBIAN_FRONTEND=noninteractive
          export NEEDRESTART_MODE=l
          export NEEDRESTART_SUSPEND=1

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 02/16] INSTALL GNOME DESKTOP${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Installing full GNOME desktop (approx 2GB, please wait)...${C_NC}"

          # ============================================================
          # PERF: pre-download paralel asset eksternal selagi apt install
          # GNOME berjalan (download ~200MB vs unpack apt ~2GB berbarengan).
          # PID background dicek via `wait` di akhir step ini; step konsumen
          # punya fallback re-download bila file tak ada/rusak.
          # ============================================================
          echo -e "${C_YELLOW}[INFO] Pre-downloading external assets in background (parallel w/ apt)...${C_NC}"
          nohup wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -O /tmp/google-chrome.deb &
          CHROME_DL=$!

          # Slim font: metapackage fonts-noto merekomendasikan font raksasa
          # (fonts-noto-cjk 61MB, cjk-extra 145MB, extra 78.5MB) yang tidak
          # dibutuhkan desktop. Pin negative membuat apt melewatinya
          # (safe: hanya Recommends, bukan Depends). Pin dihapus lagi setelah
          # install agar install font di sesi CRD nanti tetap normal.
          sudo tee /etc/apt/preferences.d/99-no-noto-heavy > /dev/null <<'PREFE'
          Package: fonts-noto-cjk fonts-noto-cjk-extra fonts-noto-extra
          Pin: version *
          Pin-Priority: -1
          PREFE

          # Blokir snapd + deb transisi (thunderbird/firefox -> snap) sudah
          # dilakukan DI AWAL di STEP 01 (purge + hold + pin, sebelum upgrade).
          # Pin masih aktif sampai baris rm di bawah; hold mencegah re-install
          # oleh operasi apt berikutnya (VS Code, CRD, dll).
          # Perf build-time: --force-unsafe-io membuat dpkg unpack TANPA fsync
          # per file (aman di runner ephemeral; memangkas waktu unpack secara
          # nyata). ubuntu-desktop-minimal hanyalah SUBSET dari ubuntu-desktop,
          # jadi keduanya tidak perlu (duplikat -> hemat waktu + disk).
          sudo NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive eatmydata apt-get install -y \
            -o Dpkg::Options::="--force-confdef" \
            -o Dpkg::Options::="--force-confold" \
            -o Dpkg::Options::="--force-unsafe-io" \
            -o Dpkg::Use-Pty=0 \
            ubuntu-desktop \
            gnome-shell \
            gnome-control-center \
            nautilus \
            gnome-terminal \
            dbus-x11 \
            x11-xserver-utils \
            xorg \
            adwaita-icon-theme \
            fonts-cantarell \
            qemu-system-x86 \
            qemu-utils \
            libvirt-daemon-system \
            libvirt-clients \
            virtinst \
            virt-manager \
            gnome-boxes

          # Pin 99-no-snap dibuat di STEP 01; hapus setelah install GNOME
          # (hold snapd/thunderbird/firefox tetap mencegah re-install).
          sudo rm -f /etc/apt/preferences.d/99-no-snap.pref

          # Purge + hold + rm snap dirs sudah dilakukan di STEP 01 (paling awal).

          sudo rm -f /etc/apt/preferences.d/99-no-noto-heavy
          echo -e "${C_GREEN}[OK] Heavy Noto fonts (cjk / cjk-extra / extra) skipped (~285MB saved).${C_NC}"

          echo -e "${C_YELLOW}[INFO] Waiting for background pre-downloads...${C_NC}"
          wait $CHROME_DL || echo -e "${C_YELLOW}[WARN] chrome deb download gagal (fallback di step berikut).${C_NC}"
          ls -l /tmp/google-chrome.deb 2>/dev/null || true

          echo -e "${C_YELLOW}[INFO] Compiling GSettings schemas...${C_NC}"
          sudo glib-compile-schemas /usr/share/glib-2.0/schemas/ || true

          echo "------------------------------------------------------------"
          gnome-shell --version || true
          gnome-control-center --version || true
          ls /usr/share/xsessions/ubuntu.desktop || true
          echo "------------------------------------------------------------"

          echo -e "${C_GREEN}[OK] GNOME installed: $(gnome-shell --version 2>/dev/null || echo 'version check skipped')${C_NC}"


      # ============================================================
      # CREATE REMOTE USER
      # ============================================================
      - name: Setup Remote User
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 03/16] SETUP REMOTE USER${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Creating user 'runner'...${C_NC}"
          sudo useradd \
            -m \
            -s /bin/bash \
            runner || true

          echo "runner:root" | sudo chpasswd

          sudo usermod -aG sudo runner

          echo -e "${C_YELLOW}[INFO] Gibah akses KVM + libvirt ke runner...${C_NC}"
          sudo usermod -aG kvm runner || echo -e "${C_YELLOW}[WARN] group 'kvm' tidak ada di runner ini (KVM off).${C_NC}"
          sudo usermod -aG libvirt runner || true
          # Restart CRD daemon agar systemd re-init supplementary groups (kvm,
          # libvirt) dari /etc/group. Tanpa ini, daemon yang hidup SEBELUM usermod
          # mewariskan grup stale ke semua sesi -> virt-manager gagal di
          # libvirt-sock ("Permission denied") dan /dev/kvm tak terbaca.
          sudo systemctl restart chrome-remote-desktop@runner 2>/dev/null || true
          getent group kvm libvirt || true
          if sudo -u runner test -r /dev/kvm && sudo -u runner test -w /dev/kvm; then
            echo -e "${C_GREEN}[OK] runner dapat mengakses /dev/kvm (KVM enabled).${C_NC}"
          else
            echo -e "${C_YELLOW}[WARN] /dev/kvm belum bisa diakses runner (butuh re-login).${C_NC}"
          fi

          echo -e "${C_YELLOW}[INFO] Setting NEEDRESTART_MODE=l for runner (prevents service restart during apt)...${C_NC}"
          echo 'export NEEDRESTART_MODE=l' | sudo tee -a /home/runner/.bashrc > /dev/null
          echo 'export NEEDRESTART_SUSPEND=1' | sudo tee -a /home/runner/.bashrc > /dev/null

          sudo mkdir -p /home/runner/Desktop

          sudo chown -R runner:runner /home/runner

          echo -e "${C_GREEN}[OK] Remote user 'runner' created: $(id runner)${C_NC}"


      # ============================================================
      # INSTALL GOOGLE CHROME
      # ============================================================
      - name: Install Google Chrome
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 04/16] INSTALL GOOGLE CHROME${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Downloading Google Chrome stable...${C_NC}"
          if [ -s /tmp/google-chrome.deb ]; then
            echo -e "${C_GREEN}[OK] Chrome .deb sudah ter-pre-download (paralel dengan apt GNOME).${C_NC}"
          else
            wget -q \
              https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
              -O /tmp/google-chrome.deb
          fi

          echo -e "${C_YELLOW}[INFO] Installing .deb package...${C_NC}"
          sudo NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive eatmydata apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" -o Dpkg::Options::="--force-unsafe-io" -o Dpkg::Use-Pty=0 /tmp/google-chrome.deb

          rm -f /tmp/google-chrome.deb

          echo -e "${C_GREEN}[OK] Google Chrome installed: $(google-chrome --version)${C_NC}"


      # ============================================================
      # INSTALL VS CODE
      # ============================================================
      - name: Install VS Code
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 05/16] INSTALL VS CODE${C_NC}"
          echo "------------------------------------------------------------"

          # Repo VS Code sudah di-setup + di-update SATU kali di STEP 01.
          # Di sini hanya verifikasi .list ada; install langsung tanpa apt-get update.
          echo -e "${C_YELLOW}[INFO] Checking VS Code repository (configured in STEP 01)...${C_NC}"
          if [ ! -f /etc/apt/sources.list.d/vscode.list ]; then
            echo -e "${C_RED}[FAIL] /etc/apt/sources.list.d/vscode.list tidak ada (setup STEP 01 gagal).${C_NC}"
            exit 1
          fi

          echo -e "${C_YELLOW}[INFO] Installing VS Code...${C_NC}"
          sudo NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive eatmydata apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" -o Dpkg::Options::="--force-unsafe-io" -o Dpkg::Use-Pty=0 code

          echo -e "${C_GREEN}[OK] VS Code installed: $(code --version | head -n 1)${C_NC}"


      # ============================================================
      # INSTALL OPENCODE CLI
      # ============================================================
      - name: Install OpenCode CLI
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 06/16] INSTALL OPENCODE CLI${C_NC}"
          echo "------------------------------------------------------------"

          # curl sudah tersedia di image ubuntu-24.04, tidak perlu install.
          # apt-get update juga tidak diperlukan: step ini tidak menambah repo
          # (update terakhir sudah dipastikan segar oleh step VS Code / CRD).

          # NOTE: installer opencode.ai/install mengabaikan
          # OPENCODE_INSTALL_DIR dan selalu install ke $HOME/.opencode/bin.
          # $GITHUB_PATH dari installer hanya berlaku untuk step berikutnya,
          # jadi export PATH manual untuk step yang sama.
          echo -e "${C_YELLOW}[INFO] Running official OpenCode installer...${C_NC}"
          curl -fsSL https://opencode.ai/install | bash

          export PATH="$HOME/.opencode/bin:$PATH"

          # Salin system-wide agar tersedia untuk root + runner +
          # GNOME Terminal via CRD (yang tidak selalu load ~/.bashrc baru).
          sudo cp "$HOME/.opencode/bin/opencode" /usr/local/bin/opencode || true
          sudo chmod +x /usr/local/bin/opencode || true

          echo -e "${C_GREEN}[OK] OpenCode CLI installed: $(opencode --version)${C_NC}"
          echo -e "${C_GREEN}[OK] Binary location: $(which opencode)${C_NC}"


      # ============================================================
      # INSTALL CHROME REMOTE DESKTOP
      # ============================================================
      - name: Install Chrome Remote Desktop
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 07/16] INSTALL CHROME REMOTE DESKTOP${C_NC}"
          echo "------------------------------------------------------------"

          # Repo CRD sudah di-setup + di-update SATU kali di STEP 01.
          # Di sini hanya verifikasi .list ada; install langsung tanpa apt-get update.
          echo -e "${C_YELLOW}[INFO] Checking CRD repository (configured in STEP 01)...${C_NC}"
          if [ ! -f /etc/apt/sources.list.d/chrome-remote-desktop.list ]; then
            echo -e "${C_RED}[FAIL] /etc/apt/sources.list.d/chrome-remote-desktop.list tidak ada (setup STEP 01 gagal).${C_NC}"
            exit 1
          fi

          echo -e "${C_YELLOW}[INFO] Installing chrome-remote-desktop...${C_NC}"
          sudo NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive eatmydata apt-get install -y \
            -o Dpkg::Options::="--force-confdef" \
            -o Dpkg::Options::="--force-confold" \
            -o Dpkg::Options::="--force-unsafe-io" \
            -o Dpkg::Use-Pty=0 \
            chrome-remote-desktop

          echo -e "${C_GREEN}[OK] Chrome Remote Desktop installed.${C_NC}"


      # ============================================================
      # CONFIGURE GNOME SESSION (CRD HEADLESS, ROBUST — NO FRAGILE XSESSION WRAPPER)
      # Pelajaran dari `apt upgrade` memutus sesi + error lightdm/Xsession:
      # panggil /usr/bin/gnome-session via absolute path + env eksplisit,
      # samakan ketahanan dengan cinnamon.yml (direct exec + software rendering).
      # ============================================================
      - name: Configure CRD GNOME Session
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 08/16] CONFIGURE GNOME SESSION${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Detecting available GNOME session...${C_NC}"
          ls /usr/share/xsessions/*.desktop || true
          grep -h "^Exec=" /usr/share/xsessions/*.desktop || true
          ls -l /usr/bin/gnome-session* || true
          ls /usr/share/gnome-session/sessions/ || true

          echo -e "${C_YELLOW}[INFO] Fail-fast: binary wajib harus ada...${C_NC}"
          test -x /usr/bin/gnome-session || { echo -e "${C_RED}[FAIL] /usr/bin/gnome-session missing.${C_NC}"; exit 1; }

          # Pilih nama session yang benar-benar ada: ubuntu > gnome > gnome-xorg.
          GNOME_SESSION_NAME=""
          if [ -f /usr/share/gnome-session/sessions/ubuntu.session ]; then
            GNOME_SESSION_NAME="ubuntu"
          elif [ -f /usr/share/gnome-session/sessions/gnome.session ]; then
            GNOME_SESSION_NAME="gnome"
          elif [ -f /usr/share/gnome-session/sessions/gnome-xorg.session ]; then
            GNOME_SESSION_NAME="gnome-xorg"
          else
            echo -e "${C_RED}[FAIL] tidak ada *.session yang dikenal di /usr/share/gnome-session/sessions/.${C_NC}"
            ls /usr/share/gnome-session/sessions/ || true
            exit 1
          fi
          echo -e "${C_YELLOW}[INFO] Using gnome-session --session=$GNOME_SESSION_NAME${C_NC}"

          RUNNER_UID=$(id -u runner)
          echo -e "${C_YELLOW}[INFO] runner UID=$RUNNER_UID${C_NC}"
          sudo mkdir -p "/run/user/$RUNNER_UID"
          sudo chown runner:runner "/run/user/$RUNNER_UID"
          sudo chmod 700 "/run/user/$RUNNER_UID"

          # Resolusi FIXED 1600x1200 via dummy driver (bukan auto-detect).
          # Xorg yang di-start CRD membaca konfigurasi ini; Mode tunggal
          # membuat sesi deterministik dan lebih cepat start (tanpa probing
          # xrandr berulang saat Xorg belum siap).
          echo -e "${C_YELLOW}[INFO] Writing fixed X11 dummy config (1600x1200, no auto-detect)...${C_NC}"
          sudo mkdir -p /etc/X11/xorg.conf.d
          sudo tee /etc/X11/xorg.conf.d/10-dummy.conf > /dev/null <<'XORG'
          Section "Device"
            Identifier "DummyDevice"
            Driver "dummy"
            VideoRam 256000
          EndSection
          Section "Monitor"
            Identifier "DummyMonitor"
            Modeline "1600x1200" 129.00 1600 1664 1856 2160 1200 1201 1204 1250
            Option "PreferredMode" "1600x1200"
          EndSection
          Section "Screen"
            Identifier "DummyScreen"
            Device "DummyDevice"
            Monitor "DummyMonitor"
            DefaultDepth 24
            SubSection "Display"
              Depth 24
              Modes "1600x1200"
            EndSubSection
          EndSection
          XORG

          echo -e "${C_YELLOW}[INFO] Writing .chrome-remote-desktop-session (direct absolute-path exec, fixed resolution)...${C_NC}"
          sudo -u runner tee /home/runner/.chrome-remote-desktop-session > /dev/null <<EOF
          export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
          export NEEDRESTART_MODE=l
          DESKTOP_SESSION=$GNOME_SESSION_NAME
          XDG_CURRENT_DESKTOP=ubuntu:GNOME
          XDG_SESSION_TYPE=x11
          XDG_RUNTIME_DIR=/run/user/$RUNNER_UID
          LIBGL_ALWAYS_SOFTWARE=1
          MUTTER_DEBUG_FORCE_SOFTWARE_RENDER=1

          # Resolusi statis: dummy driver mengekspos mode 1600x1200 yang sudah
          # di-set via /etc/X11/xorg.conf.d/10-dummy.conf. Tanpa retry xrandr
          # otomatis -> start sesi lebih cepat & deterministik.

          exec /usr/bin/gnome-session --session=$GNOME_SESSION_NAME
          EOF

          sudo chown runner:runner \
            /home/runner/.chrome-remote-desktop-session

          sudo chmod +x \
            /home/runner/.chrome-remote-desktop-session

          echo "------------------------------------------------------------"
          cat /home/runner/.chrome-remote-desktop-session || true
          echo "------------------------------------------------------------"
          echo -e "${C_YELLOW}[INFO] Final check: no Xsession/lightdm wrapper allowed...${C_NC}"
          if grep -q "Xsession\|lightdm" /home/runner/.chrome-remote-desktop-session; then
            echo -e "${C_RED}[FAIL] session file masih mengandung Xsession/lightdm.${C_NC}"
            exit 1
          fi

          echo -e "${C_GREEN}[OK] GNOME session configured for CRD (session=$GNOME_SESSION_NAME).${C_NC}"


      # ============================================================
      # DISABLE SCREENSAVER + LOCK + SUSPEND (HEADLESS CRD)
      # Mencegah GNOME mengunci/mematikan layar dan memutus sesi CRD.
      # + TUNE GNOME PERFORMANCE: sesi berjalan di software rendering
      # (llvmpipe) sehingga semua beban animasi/indexing/popup dimatikan.
      # ============================================================
      - name: Disable Screensaver, Lock, and Tune Performance
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 09/16] DISABLE SCREENSAVER / LOCK + PERFORMANCE TUNES${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Disabling GNOME lock/suspend system-wide...${C_NC}"
          sudo mkdir -p /etc/dconf/db/local.d || true
          sudo tee /etc/dconf/db/local.d/99-crd-no-lock > /dev/null <<'EOF'
          [org/gnome/desktop/session]
          idle-delay=0
          [org/gnome/desktop/screensaver]
          lock-enabled=false
          idle-activation-enabled=false
          lock-delay=0
          [org/gnome/settings-daemon/plugins/power]
          sleep-inactive-ac-type='nothing'
          sleep-inactive-battery-type='nothing'
          ambient-enabled=false
          EOF
          sudo dconf update || true

          # Fallback per-user gsettings (jalan saat sesi aktif; abaikan bila dbus belum ada).
          sudo -u runner dbus-launch --exit-with-session gsettings set org.gnome.desktop.screensaver lock-enabled false || true
          sudo -u runner dbus-launch --exit-with-session gsettings set org.gnome.desktop.screensaver idle-activation-enabled false || true
          sudo -u runner dbus-launch --exit-with-session gsettings set org.gnome.desktop.session idle-delay 0 || true
          sudo -u runner dbus-launch --exit-with-session gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing' || true
          sudo chown -R runner:runner /home/runner/.config || true

          # ============================================================
          # PERFORMANCE TUNING (software rendering / llvmpipe)
          # ============================================================
          echo -e "${C_YELLOW}[INFO] Disabling GNOME animations (llvmpipe software rendering)...${C_NC}"
          sudo tee /etc/dconf/db/local.d/99-gnome-perf > /dev/null <<'EOF'
          [org/gnome/desktop/interface]
          enable-animations=false
          [org/gnome/shell]
          disable-user-extensions=true
          EOF
          sudo dconf update || true
          sudo -u runner dbus-run-session -- gsettings set org.gnome.desktop.interface enable-animations false || true
          sudo -u runner dbus-run-session -- gsettings set org.gnome.shell disable-user-extensions true || true

          echo -e "${C_YELLOW}[INFO] Disabling Tracker3 file indexer (CPU/IO hog di sesi headless)...${C_NC}"
          sudo -u runner dbus-run-session -- gsettings set org.freedesktop.tracker3.miner.files crawling-interval -2 || true
          sudo -u runner dbus-run-session -- gsettings set org.freedesktop.tracker3.miner.files enable-monitors false || true
          sudo -u runner dbus-run-session -- gsettings set org.freedesktop.tracker3.miner.files index-recursive-directories "[]" || true
          sudo -u runner dbus-run-session -- gsettings set org.freedesktop.tracker3.miner.files index-single-directories "[]" || true
          sudo systemctl --global mask tracker-extract-3.service tracker-miner-fs-3.service tracker-miner-rss-3.service 2>/dev/null || true

          echo -e "${C_YELLOW}[INFO] Disabling crash-report daemons + updater popups...${C_NC}"
          sudo systemctl disable --now whoopsie 2>/dev/null || true
          sudo systemctl disable --now apport 2>/dev/null || true
          sudo rm -f /etc/xdg/autostart/update-notifier.desktop /etc/xdg/autostart/org.gnome.Software.desktop 2>/dev/null || true

          echo -e "${C_GREEN}[OK] Screensaver, lock, suspend disabled + performance tuned.${C_NC}"


      # ============================================================
      # INSTALL SAFE-UPGRADE HELPER
      # Pengganti `sudo apt upgrade` manual yang memutus sesi CRD.
      # ============================================================
      - name: Install Safe Upgrade Helper
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 10/16] INSTALL SAFE-UPGRADE HELPER${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Copying repo scripts/safe-upgrade.sh...${C_NC}"
          if [ ! -f "$GITHUB_WORKSPACE/scripts/safe-upgrade.sh" ]; then
            echo -e "${C_RED}[FAIL] scripts/safe-upgrade.sh tidak ditemukan (checkout gagal).${C_NC}"
            exit 1
          fi
          sudo cp "$GITHUB_WORKSPACE/scripts/safe-upgrade.sh" /usr/local/bin/safe-upgrade
          sudo chmod +x /usr/local/bin/safe-upgrade || true
          sudo ln -sf /usr/local/bin/safe-upgrade /usr/bin/safe-upgrade || true

          # Shortcut Desktop + MOTD warning agar user tidak `apt upgrade` polos.
          sudo -u runner bash -c 'cat > /home/runner/Desktop/SafeUpgrade.desktop <<EOF
          [Desktop Entry]
          Version=1.0
          Type=Application
          Name=Safe Upgrade
          Comment=Gunakan ini pengganti apt upgrade (anti putus CRD)
          Exec=gnome-terminal -- bash -c "safe-upgrade; echo; read -n1 -p \"Tekan tombol untuk tutup...\""
          Icon=system-software-update
          Terminal=false
          EOF'
          sudo chmod +x /home/runner/Desktop/SafeUpgrade.desktop || true
          sudo chown runner:runner /home/runner/Desktop/SafeUpgrade.desktop || true

          echo 'JANGAN jalankan `sudo apt upgrade -y` polos di sesi CRD (memutus koneksi). Pakai: safe-upgrade' \
            | sudo tee /etc/motd > /dev/null || true

          echo "------------------------------------------------------------"
          ls -l /usr/local/bin/safe-upgrade || true
          safe-upgrade --help || true
          echo "------------------------------------------------------------"

          echo -e "${C_GREEN}[OK] safe-upgrade installed. Gunakan \`safe-upgrade\` pengganti \`apt upgrade\`.${C_NC}"


      # ============================================================
      # CREATE DESKTOP SHORTCUTS
      # ============================================================
      - name: Create Desktop Shortcuts
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 11/16] CREATE DESKTOP SHORTCUTS${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Creating Antigravity shortcut...${C_NC}"
          sudo -u runner bash -c 'cat > /home/runner/Desktop/Antigravity.desktop <<EOF
          [Desktop Entry]
          Version=1.0
          Type=Application
          Name=Google Antigravity
          Comment=Open Google Antigravity
          Exec=google-chrome --app=https://antigravity.google/ --no-sandbox
          Icon=google-chrome
          Terminal=false
          EOF'

          echo -e "${C_YELLOW}[INFO] Creating VS Code shortcut...${C_NC}"
          sudo -u runner bash -c 'cat > /home/runner/Desktop/VSCode.desktop <<EOF
          [Desktop Entry]
          Version=1.0
          Type=Application
          Name=Visual Studio Code
          Comment=Visual Studio Code
          Exec=code
          Icon=code
          Terminal=false
          EOF'

          sudo chmod +x /home/runner/Desktop/*.desktop

          sudo chown -R runner:runner /home/runner/Desktop

          echo "------------------------------------------------------------"
          ls -l /home/runner/Desktop/*.desktop || true
          echo "------------------------------------------------------------"

          echo -e "${C_GREEN}[OK] Desktop shortcuts created.${C_NC}"


      # ============================================================
      # SET WALLPAPER (BLACK UNICAT / CATPPUCCIN)
      # ============================================================
      - name: Set Wallpaper
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 12/16] SET WALLPAPER${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Downloading Catppuccin 'black unicat' wallpaper...${C_NC}"
          sudo -u runner mkdir -p /home/runner/Pictures
          sudo -u runner wget -q -O /home/runner/Pictures/wallpaper.png \
            "https://raw.githubusercontent.com/zhichaoh/catppuccin-wallpapers/refs/heads/main/minimalistic/black5_unicat.png" \
            || { echo -e "${C_RED}[FAIL] Gagal mengunduh wallpaper.${C_NC}"; exit 1; }
          sudo chown runner:runner /home/runner/Pictures/wallpaper.png

          echo -e "${C_YELLOW}[INFO] Setting wallpaper via gsettings (GNOME schema)...${C_NC}"
          # dbus-run-session menyediakan session dbus sementara agar gsettings
          # menulis ke dconf user 'runner', yang dipakai saat CRD session menyala.
          sudo -u runner dbus-run-session -- gsettings set org.gnome.desktop.background picture-uri "file:///home/runner/Pictures/wallpaper.png" || true
          sudo -u runner dbus-run-session -- gsettings set org.gnome.desktop.background picture-uri-dark "file:///home/runner/Pictures/wallpaper.png" || true
          sudo -u runner dbus-run-session -- gsettings set org.gnome.desktop.background picture-options "zoom" || true
          sudo -u runner dbus-run-session -- gsettings set org.gnome.desktop.background picture-options-dark "zoom" || true

          # Fallback autostart: set ulang wallpaper saat session mulai,
          # meng-cover kasus dconf belum tercatat sebelum desktop jalan.
          sudo -u runner mkdir -p /home/runner/.config/autostart
          sudo -u runner bash -c 'cat > /home/runner/.config/autostart/set-wallpaper.desktop <<EOF
          [Desktop Entry]
          Type=Application
          Name=Set Wallpaper
          Exec=sh -c "sleep 3; gsettings set org.gnome.desktop.background picture-uri file:///home/runner/Pictures/wallpaper.png; gsettings set org.gnome.desktop.background picture-uri-dark file:///home/runner/Pictures/wallpaper.png; gsettings set org.gnome.desktop.background picture-options zoom"
          X-GNOME-Autostart-enabled=true
          Terminal=false
          EOF'

          echo "------------------------------------------------------------"
          ls -l /home/runner/Pictures/wallpaper.png || true
          sudo -u runner file /home/runner/Pictures/wallpaper.png || true
          echo "------------------------------------------------------------"

          echo -e "${C_GREEN}[OK] Wallpaper installed and set for runner.${C_NC}"


      # ============================================================
      # SET CRD PIN
      #
      # Default:
      #   123456
      #
      # Custom:
      #   Create GitHub Actions secret/variable:
      #
      #   CRD_PIN=your-pin
      # ============================================================
      - name: Configure CRD PIN
        env:
          CUSTOM_CRD_PIN: ${{ secrets.CRD_PIN }}
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 13/16] CONFIGURE CRD PIN${C_NC}"
          echo "------------------------------------------------------------"

          if [ -n "$CUSTOM_CRD_PIN" ]; then
            CRD_PIN="$CUSTOM_CRD_PIN"
            echo -e "${C_YELLOW}[INFO] Using custom CRD PIN from secret CRD_PIN.${C_NC}"
          else
            CRD_PIN="123456"
            echo -e "${C_YELLOW}[INFO] No CRD_PIN secret found.${C_NC}"
            echo -e "${C_YELLOW}[INFO] Using default PIN: 123456${C_NC}"
          fi

          # Validate PIN
          if ! [[ "$CRD_PIN" =~ ^[0-9]{6,}$ ]]; then
            echo -e "${C_RED}[FAIL] CRD_PIN must contain at least 6 digits.${C_NC}"
            exit 1
          fi

          echo "::add-mask::$CRD_PIN"

          echo "CRD_PIN=$CRD_PIN" >> "$GITHUB_ENV"

          echo -e "${C_GREEN}[OK] CRD PIN configured.${C_NC}"


      # ============================================================
      # REGISTER CHROME REMOTE DESKTOP
      # ============================================================
      - name: Register Chrome Remote Desktop
        env:
          CRD_COMMAND: ${{ inputs.crd_host_command }}
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 14/16] REGISTER CHROME REMOTE DESKTOP${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Validating host command input...${C_NC}"

          # Bersihkan input: hapus CR/LF ekstra + spasi trailing.
          CRD_COMMAND_CLEAN="$(printf '%s' "$CRD_COMMAND" | tr -d '\r' | sed 's/[[:space:]]*$//')"

          if [ -z "$CRD_COMMAND_CLEAN" ]; then
            echo -e "${C_RED}[FAIL] CRD host command is empty.${C_NC}"
            exit 1
          fi
          if ! printf '%s' "$CRD_COMMAND_CLEAN" | grep -q 'start-host'; then
            echo -e "${C_RED}[FAIL] Input tidak mengandung 'start-host'.${C_NC}"
            echo -e "${C_RED}       Salin SELURUH perintah Debian Linux dari https://remotedesktop.google.com/headless${C_NC}"
            exit 1
          fi
          if printf '%s' "$CRD_COMMAND_CLEAN" | grep -q -- '--pin'; then
            echo -e "${C_YELLOW}[WARN] Input sudah mengandung --pin; nilai dari secret/default akan dipakai.${C_NC}"
          fi
          echo -e "${C_YELLOW}[INFO] CRD command valid ($(printf '%s' "$CRD_COMMAND_CLEAN" | wc -c) chars, contains start-host).${C_NC}"

          # Ganti nama perangkat CRD agar tampil sebagai "gnome" (bukan hostname runner).
          CRD_COMMAND_CLEAN="$(printf '%s' "$CRD_COMMAND_CLEAN" | sed -E 's/--name=[^ ]*//')"
          CRD_COMMAND_CLEAN="$CRD_COMMAND_CLEAN --name=\"gnome\""
          echo -e "${C_YELLOW}[INFO] CRD device name di-override menjadi 'gnome'.${C_NC}"

          echo -e "${C_YELLOW}[INFO] Registering host as user 'runner' (retry 3x jika OAuth transien)...${C_NC}"

          # Jalankan command CRD sebagai user runner.
          # PIN diberikan melalui environment CRD_PIN.
          # Retry + backoff: auth code Google single-use mudah gagal karena
          # kadaluarsa/terpakai/transien — terapkan retry sebelum menyerah.
          rc=1
          attempt=0
          while [ "$attempt" -lt 3 ]; do
            attempt=$((attempt + 1))
            echo -e "${C_YELLOW}[INFO] Registration attempt ${attempt}/3 ...${C_NC}"
            if sudo -u runner \
              env CRD_PIN="$CRD_PIN" \
              bash -c "$CRD_COMMAND_CLEAN --pin=\"$CRD_PIN\""; then
              rc=0
              break
            fi
            if [ "$attempt" -lt 3 ]; then
              echo -e "${C_YELLOW}[WARN] Registration gagal (mungkin kode single-use kadaluarsa/terpakai, atau error transien). Retry dalam $((attempt * 15))s...${C_NC}"
              sleep $((attempt * 15))
            fi
          done

          if [ "$rc" -ne 0 ]; then
            echo ""
            echo -e "${C_RED}[FAIL] Registrasi Chrome Remote Desktop gagal (OAuth error).${C_NC}"
            echo -e "${C_RED}  Penyebab paling umum: kode auth Google single-use sudah kadaluarsa/terpakai.${C_NC}"
            echo -e "${C_RED}  Pulih TANPA menunggu install ulang (apt sudah tercache, re-run cepat):${C_NC}"
            echo -e "${C_RED}  1) Buka https://remotedesktop.google.com/headless${C_NC}"
            echo -e "${C_RED}  2) Begin -> Next -> Authorize sampai muncul perintah baru.${C_NC}"
            echo -e "${C_RED}  3) Salin perintah Debian Linux versi BARU, lalu Re-run workflow ini.${C_NC}"
            exit 1
          fi

          echo ""
          echo "=============================================================="
          echo -e "${C_GREEN}      [OK] CHROME REMOTE DESKTOP READY${C_NC}"
          echo "=============================================================="
          echo -e "      [INFO] Access    : https://remotedesktop.google.com/access"
          echo -e "      [INFO] User      : runner"
          echo -e "      [INFO] PIN       : default 123456 (or custom via secret CRD_PIN)"
          echo "=============================================================="
          echo ""
          echo "::notice::CRD ready - connect via https://remotedesktop.google.com/access as user runner"


      # ============================================================
      # VERIFY
      # ============================================================
      - name: Verify Installation
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[STEP 15/16] VERIFY INSTALLATION${C_NC}"
          echo "------------------------------------------------------------"

          echo "::group::[CHECK] System"
          uname -a
          echo "::endgroup::"

          echo "::group::[CHECK] GNOME session (robust, no Xsession wrapper)"
          gnome-shell --version || true
          echo "--- session file ---"
          cat /home/runner/.chrome-remote-desktop-session || true
          echo "--- no Xsession/lightdm wrapper allowed ---"
          grep -r "Xsession\|lightdm" /home/runner/.chrome-remote-desktop-session && echo "[FAIL] session file masih pakai wrapper!" && exit 1 || echo "[OK] session file direct exec, bersih"
          grep -q "exec /usr/bin/gnome-session --session=" /home/runner/.chrome-remote-desktop-session || { echo "[FAIL] exec line tidak sesuai harapan!"; exit 1; }
          echo "::endgroup::"

          echo "::group::[CHECK] screensaver/lock disabled"
          cat /etc/dconf/db/local.d/99-crd-no-lock || true
          echo "::endgroup::"

          echo "::group::[CHECK] performance tuning + fixed resolution"
          cat /etc/dconf/db/local.d/99-gnome-perf || true
          cat /etc/X11/xorg.conf.d/10-dummy.conf 2>/dev/null || echo "[WARN] 10-dummy.conf missing"
          systemctl is-enabled whoopsie 2>/dev/null | grep -q disabled && echo "[OK] whoopsie disabled" || echo "[WARN] whoopsie active"
          systemctl is-enabled apport 2>/dev/null | grep -q disabled && echo "[OK] apport disabled" || echo "[WARN] apport active"
          grep -q "xrandr" /home/runner/.chrome-remote-desktop-session 2>/dev/null && echo "[WARN] xrandr auto-set masih ada di session file" || echo "[OK] session bersih (tanpa auto-set display)"
          ls /home/runner/.config/autostart/set-resolution.desktop 2>/dev/null && echo "[WARN] autostart set-resolution lama masih ada" || echo "[OK] autostart set-resolution dihapus"
          echo "::endgroup::"

          echo "::group::[CHECK] safe-upgrade helper"
          which safe-upgrade || true
          ls -l /usr/local/bin/safe-upgrade || true
          safe-upgrade --help || true
          ls -l /home/runner/Desktop/SafeUpgrade.desktop || true
          echo "::endgroup::"

          echo "::group::[CHECK] Google Chrome"
          google-chrome --version || true
          echo "::endgroup::"

          echo "::group::[CHECK] VS Code"
          code --version || true
          echo "::endgroup::"

          echo "::group::[CHECK] OpenCode CLI"
          opencode --version || true
          which opencode || true
          echo "::endgroup::"

          echo "::group::[CHECK] Chrome Remote Desktop service"
          systemctl status \
            chrome-remote-desktop@runner.service \
            --no-pager \
            || true
          echo "::endgroup::"

          echo "::group::[CHECK] Remote user"
          id runner
          echo "::endgroup::"

          echo "::group::[CHECK] KVM / Virtualization"
          ls -l /dev/kvm || true
          getent group kvm libvirt || true
          if sudo -u runner test -r /dev/kvm && sudo -u runner test -w /dev/kvm; then
            echo -e "${C_GREEN}[OK] runner dapat mengakses /dev/kvm.${C_NC}"
          else
            echo -e "${C_YELLOW}[WARN] runner tidak bisa akses /dev/kvm - instalasi tetap OK; KVM off di runner ini (lihat README, bagian KVM).${C_NC}"
          fi
          command -v qemu-system-x86_64 || echo "[WARN] qemu-system-x86_64 missing"
          command -v virsh || echo "[WARN] virsh missing"
          command -v virt-manager || echo "[WARN] virt-manager missing"
          command -v gnome-boxes || echo "[WARN] gnome-boxes missing"
          systemctl is-enabled libvirtd 2>/dev/null || true
          systemctl is-active libvirtd 2>/dev/null || true
          echo "::endgroup::"

          echo "::group::[CHECK] Snap removed"
          command -v snap >/dev/null 2>&1 && echo -e "${C_YELLOW}[WARN] snap masih terpasang.${C_NC}" || echo -e "${C_GREEN}[OK] snap / snapd removed.${C_NC}"
          dpkg -l thunderbird 2>/dev/null | grep -q ^ii && echo -e "${C_YELLOW}[WARN] thunderbird transisi masih terpasang.${C_NC}" || echo -e "${C_GREEN}[OK] thunderbird (snap transitional) removed.${C_NC}"
          apt-mark showhold | grep -qx snapd && echo -e "${C_GREEN}[OK] snapd held (tidak akan re-install).${C_NC}" || echo -e "${C_YELLOW}[WARN] snapd tidak di-hold.${C_NC}"
          echo "::endgroup::"

          echo ""
          echo -e "${C_GREEN}[OK] Installation verification completed.${C_NC}"


      # ============================================================
      # PTERODACTYL PANEL + TUNNELING
      # Replikasi setup yang terverifikasi (panel + wings + 2 tunnel
      # cloudflared: panel->80, wings->443). Panel hidup sebelum
      # Keep Alive sehingga bisa dipakai orang lain selama 6 jam.
      # ============================================================

      - name: "PTERO 1/6 Install Dependencies (PHP, MariaDB, Redis, Nginx, cloudflared)"
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[PTERO 1/6] INSTALL DEPENDENCIES (PHP 8.3 + MariaDB + Redis + Nginx + cloudflared)${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Purging any preinstalled MySQL/MariaDB server (avoid conflicts)...${C_NC}"
          sudo systemctl stop mariadb mysql 2>/dev/null || true
          sudo apt-get purge -y --allow-change-held-packages \
            mysql-server mariadb-server mysql-server-core-8.0 mariadb-server-core \
            mysql-server-core mariadb-server-10.6 mysql-server-8.0 2>/dev/null || true

          echo -e "${C_YELLOW}[INFO] Installing PHP 8.3 + MariaDB + Redis + Nginx + composer...${C_NC}"
          sudo NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive eatmydata apt-get install -y \
            -o Dpkg::Options::="--force-confdef" \
            -o Dpkg::Options::="--force-confold" \
            -o Dpkg::Options::="--force-unsafe-io" \
            -o Dpkg::Use-Pty=0 \
            mariadb-server \
            php8.3-fpm php8.3-mysql php8.3-redis php8.3-curl php8.3-mbstring \
            php8.3-xml php8.3-zip php8.3-bcmath php8.3-gd php8.3-intl php8.3-sqlite3 \
            redis-server nginx composer

          echo -e "${C_YELLOW}[INFO] Installing cloudflared (deb)...${C_NC}"
          if ! command -v cloudflared >/dev/null 2>&1; then
            wget -q https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb -O /tmp/cloudflared.deb
            sudo dpkg -i /tmp/cloudflared.deb || { sudo apt-get -f install -y -o Dpkg::Options::="--force-unsafe-io"; sudo dpkg -i /tmp/cloudflared.deb; }
          fi

          sudo systemctl enable --now mariadb redis-server php8.3-fpm nginx

          echo -e "${C_YELLOW}[INFO] Creating panel database + user...${C_NC}"
          sudo mariadb <<'SQL'
          CREATE DATABASE IF NOT EXISTS panel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
          CREATE USER IF NOT EXISTS 'pterodactyl'@'127.0.0.1' IDENTIFIED BY 'pteroPass123';
          GRANT ALL PRIVILEGES ON panel.* TO 'pterodactyl'@'127.0.0.1' WITH GRANT OPTION;
          FLUSH PRIVILEGES;
          SQL

          cloudflared --version
          php -v | head -1
          mariadb --version
          echo -e "${C_GREEN}[OK] PTERO 1 dependencies installed.${C_NC}"

      # Simpan arsip .deb (termasuk paket ptero) ke cache GitHub
      # agar re-run workflow tidak perlu unduh ulang.
      - name: Sync apt cache for GitHub save
        run: |
          sudo mkdir -p /home/runner/apt-archives
          sudo cp -a /var/cache/apt/archives/. /home/runner/apt-archives/ || true
          sudo chown -R runner:runner /home/runner/apt-archives || true

      - name: "PTERO 2/6 Install Pterodactyl Panel"
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[PTERO 2/6] INSTALL PTERODACTYL PANEL${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Downloading latest panel release...${C_NC}"
          LATEST=$(curl -fsSL https://api.github.com/repos/pterodactyl/panel/releases/latest | python3 -c "import sys,json;print(json.load(sys.stdin)['tag_name'])")
          echo -e "${C_GREEN}[INFO] Panel release: $LATEST${C_NC}"
          curl -fsSL "https://codeload.github.com/pterodactyl/panel/tar.gz/refs/tags/${LATEST}" -o /tmp/panel.tar.gz
          sudo mkdir -p /var/www/pterodactyl
          sudo tar -xzf /tmp/panel.tar.gz -C /var/www/pterodactyl --strip-components=1
          sudo chown -R www-data:www-data /var/www/pterodactyl

          echo -e "${C_YELLOW}[INFO] composer install...${C_NC}"
          sudo -H -u www-data env COMPOSER_PROCESS_TIMEOUT=900 composer install --no-dev --optimize-autoloader --no-progress

          echo -e "${C_YELLOW}[INFO] Configuring .env...${C_NC}"
          sudo cp /var/www/pterodactyl/.env.example /var/www/pterodactyl/.env
          sudo sed -i \
            -e "s|^APP_URL=.*|APP_URL=http://127.0.0.1|" \
            -e "s|^DB_HOST=.*|DB_HOST=127.0.0.1|" \
            -e "s|^DB_DATABASE=.*|DB_DATABASE=panel|" \
            -e "s|^DB_USERNAME=.*|DB_USERNAME=pterodactyl|" \
            -e "s|^DB_PASSWORD=.*|DB_PASSWORD=pteroPass123|" \
            -e "s|^REDIS_HOST=.*|REDIS_HOST=127.0.0.1|" \
            -e "s|^CACHE_DRIVER=.*|CACHE_DRIVER=redis|" \
            -e "s|^SESSION_DRIVER=.*|SESSION_DRIVER=redis|" \
            -e "s|^QUEUE_CONNECTION=.*|QUEUE_CONNECTION=redis|" \
            /var/www/pterodactyl/.env
          sudo sed -i "/^RECAPTCHA_ENABLED=/d" /var/www/pterodactyl/.env
          echo "RECAPTCHA_ENABLED=false" | sudo tee -a /var/www/pterodactyl/.env >/dev/null

          echo -e "${C_YELLOW}[INFO] key:generate + migrate --seed...${C_NC}"
          cd /var/www/pterodactyl
          sudo -H -u www-data php artisan key:generate --force
          sudo -H -u www-data php artisan migrate --seed --force

          echo -e "${C_YELLOW}[INFO] Creating admin user...${C_NC}"
          sudo -H -u www-data php artisan p:user:make \
            --email=admin@pterodactyl.test \
            --username=admin \
            --name-first=Admin \
            --name-last=Pterodactyl \
            --password=AdminPass123 \
            --admin || \
            printf 'admin\nAdmin\nPterodactyl\nadmin@pterodactyl.test\nAdminPass123\n' | sudo -H -u www-data php artisan p:user:make
          sudo mariadb panel -e "SELECT id,username,root_admin FROM users WHERE username='admin'" 2>/dev/null | grep -q admin || { echo -e "${C_RED}[FAIL] admin user tidak terbuat.${C_NC}"; exit 1; }

          echo -e "${C_YELLOW}[INFO] Configuring nginx vhost...${C_NC}"
          sudo tee /etc/nginx/sites-available/pterodactyl.conf >/dev/null <<'NGINX'
          server {
              listen 80 default_server;
              listen [::]:80 default_server;
              server_name _;
              root /var/www/pterodactyl/public;
              index index.php index.html index.htm;

              location / {
                  try_files $uri $uri/ /index.php?$query_string;
              }

              location ~ \.php$ {
                  fastcgi_split_path_info ^(.+\.php)(/.+)$;
                  fastcgi_pass unix:/run/php/php8.3-fpm.sock;
                  fastcgi_index index.php;
                  include fastcgi_params;
                  fastcgi_param PHP_VALUE "upload_max_filesize = 100M
          post_max_size=100M";
                  fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
                  fastcgi_param PATH_INFO $fastcgi_path_info;
              }

              location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
                  expires 1y;
                  add_header Cache-Control "public, immutable";
                  access_log off;
              }

              location ~ /\.ht {
                  deny all;
              }

              client_max_body_size 100m;
          }
          NGINX
          sudo ln -sf /etc/nginx/sites-available/pterodactyl.conf /etc/nginx/sites-enabled/pterodactyl.conf
          sudo rm -f /etc/nginx/sites-enabled/default
          sudo nginx -t
          sudo systemctl reload nginx

          echo -e "${C_YELLOW}[INFO] Adding cron + pteroq service...${C_NC}"
          ( crontab -l 2>/dev/null | grep -v 'artisan schedule:run'; echo '* * * * * php /var/www/pterodactyl/artisan schedule:run >> /dev/null 2>&1' ) | sudo crontab -
          sudo tee /etc/systemd/system/pteroq.service >/dev/null <<'UNIT'
          [Unit]
          Description=Pterodactyl Queue Worker
          After=redis-server.service mariadb.service

          [Service]
          User=www-data
          Group=www-data
          Restart=always
          ExecStart=/usr/bin/php /var/www/pterodactyl/artisan queue:work --queue=high,standard,low --sleep=3 --tries=3

          [Install]
          WantedBy=multi-user.target
          UNIT
          sudo systemctl daemon-reload
          sudo systemctl enable --now pteroq

          code=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1/auth/login)
          echo -e "panel(local) /auth/login -> HTTP ${code}"
          [ "$code" = "200" ] || { echo -e "${C_RED}[FAIL] panel tidak 200.${C_NC}"; exit 1; }
          echo -e "${C_GREEN}[OK] PTERO 2 panel live.${C_NC}"

      - name: "PTERO 3/6 Start Cloudflare Tunnels"
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[PTERO 3/6] START CLOUDFLARE TUNNELS (panel:80, wings:443)${C_NC}"
          echo "------------------------------------------------------------"

          pkill -f "cloudflared tunnel --url" 2>/dev/null || true

          echo -e "${C_YELLOW}[INFO] Starting wings tunnel (origin http://127.0.0.1:443)...${C_NC}"
          sudo nohup cloudflared tunnel --url http://127.0.0.1:443 > /tmp/cf-wings.log 2>&1 &
          echo -e "${C_YELLOW}[INFO] Starting panel tunnel (origin http://127.0.0.1:80)...${C_NC}"
          sudo nohup cloudflared tunnel --url http://127.0.0.1:80 > /tmp/cf-panel.log 2>&1 &

          sleep 8
          WINGS_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/cf-wings.log | tail -1)
          PANEL_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/cf-panel.log | tail -1)
          for i in $(seq 1 12); do
            [ -n "$WINGS_URL" ] && [ -n "$PANEL_URL" ] && break
            sleep 5
            WINGS_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/cf-wings.log | tail -1)
            PANEL_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/cf-panel.log | tail -1)
          done
          WINGS_URL=${WINGS_URL:-UNSET}
          PANEL_URL=${PANEL_URL:-UNSET}
          echo "WINGS_URL=$WINGS_URL"
          echo "PANEL_URL=$PANEL_URL"
          echo "WINGS_URL=$WINGS_URL" >> "$GITHUB_ENV"
          echo "PANEL_URL=$PANEL_URL" >> "$GITHUB_ENV"
          echo "::notice::PANEL_URL=$PANEL_URL"
          echo "::notice::WINGS_URL=$WINGS_URL"
          if [ "$WINGS_URL" = "UNSET" ] || [ "$PANEL_URL" = "UNSET" ]; then
            echo -e "${C_RED}[WARN] salah satu tunnel belum dapat URL (masih retry via log).${C_NC}"
          fi
          echo -e "${C_GREEN}[OK] PTERO 3 tunnels started (verify URL di log /tmp/cf-*.log).${C_NC}"

      - name: "PTERO 4/6 Install + Configure Wings Daemon"
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[PTERO 4/6] INSTALL + CONFIGURE WINGS DAEMON${C_NC}"
          echo "------------------------------------------------------------"

          WINGS_URL=${WINGS_URL:-UNSET}

          echo -e "${C_YELLOW}[INFO] Generating Application API key via tinker...${C_NC}"
          sudo mkdir -p /tmp/psysh
          sudo chown -R www-data:www-data /tmp/psysh
          sudo tee /tmp/tinker_key.php >/dev/null <<'PHP'
          $u = \Pterodactyl\Models\User::query()->orderBy('id')->first();
          $service = app(\Pterodactyl\Services\Api\KeyCreationService::class);
          $perm = [];
          foreach (['locations','nodes','servers','allocations','eggs','nests','users'] as $p) { $perm['r_'.$p] = 3; }
          $key = $service->setKeyType(\Pterodactyl\Contracts\Repository\KeyRepository::TYPE_APPLICATION)
              ->handle(['memo'=>'wings-setup','user_id'=>$u->id], $perm);
          echo $key->identifier . $key->token;
          PHP
          API_KEY=$(sudo -H -u www-data env XDG_CONFIG_HOME=/tmp/psysh php /var/www/pterodactyl/artisan tinker --execute="$(cat /tmp/tinker_key.php)")
          [ -n "$API_KEY" ] || { echo -e "${C_RED}[FAIL] API key kosong.${C_NC}"; exit 1; }
          echo "API key: ${API_KEY:0:8}..."
          echo "API_KEY=$API_KEY" >> "$GITHUB_ENV"

          NODE_IP=$(hostname -I | awk '{print $1}')
          echo -e "${C_GREEN}[INFO] Internal IP untuk allocation: $NODE_IP${C_NC}"

          AUTH="Authorization: Bearer $API_KEY"
          echo -e "${C_YELLOW}[INFO] Creating location...${C_NC}"
          curl -sf -o /dev/null -X POST http://127.0.0.1/api/application/locations \
            -H "$AUTH" -H 'Accept: application/json' -H 'Content-Type: application/json' \
            -d '{"short_code":"idn-trial","description":"Temporary Trial Location (Indonesia)"}'

          echo -e "${C_YELLOW}[INFO] Creating node (fqdn=wings tunnel)...${C_NC}"
          NODE_ID=$(curl -sf -X POST http://127.0.0.1/api/application/nodes \
            -H "$AUTH" -H 'Accept: application/json' -H 'Content-Type: application/json' \
            -d '{"name":"Azure Trial Node","location_id":1,"fqdn":"'"$WINGS_URL"'","scheme":"https","behind_proxy":true,"public":true,"maintenance_mode":false,"memory":10240,"memory_overallocate":0,"disk":70000,"disk_overallocate":0,"upload_size":100,"daemon_listen":443,"daemon_sftp":2022,"daemon_base":"/srv/daemon-data"}' \
            | python3 -c "import sys,json;print(json.load(sys.stdin)['attributes']['id'])")
          echo -e "${C_GREEN}[INFO] Node id: $NODE_ID${C_NC}"

          echo -e "${C_YELLOW}[INFO] Adding allocations porta 20000-20010 pada $NODE_IP...${C_NC}"
          curl -sf -o /dev/null -X POST "http://127.0.0.1/api/application/nodes/$NODE_ID/allocations" \
            -H "$AUTH" -H 'Accept: application/json' -H 'Content-Type: application/json' \
            -d '{"ip":"'"$NODE_IP"'","ports":["20000","20001","20002","20003","20004","20005","20006","20007","20008","20009","20010"]}'

          echo -e "${C_YELLOW}[INFO] Fetching node configuration...${C_NC}"
          curl -sf "http://127.0.0.1/api/application/nodes/$NODE_ID/configuration" \
            -H "$AUTH" -H 'Accept: application/json' -o /tmp/node-config.json || exit 1
          UUID=$(python3 -c "import json;print(json.load(open('/tmp/node-config.json'))['uuid'])")
          TOKEN_ID=$(python3 -c "import json;print(json.load(open('/tmp/node-config.json'))['token_id'])")
          TOKEN=$(python3 -c "import json;print(json.load(open('/tmp/node-config.json'))['token'])")

          echo -e "${C_YELLOW}[INFO] Writing /etc/pterodactyl/config.yml (remote=http://127.0.0.1, ssl off, allowed_origins=* )...${C_NC}"
          sudo mkdir -p /etc/pterodactyl
          sudo tee /etc/pterodactyl/config.yml >/dev/null <<YML
          token: "$TOKEN"
          token_id: "$TOKEN_ID"
          uuid: "$UUID"

          api:
            host: 0.0.0.0
            port: 443
            ssl:
              enabled: false
              cert: /etc/letsencrypt/live/example.com/fullchain.pem
              key: /etc/letsencrypt/live/example.com/privkey.pem
            upload_limit: 100
            trusted_proxies: []

          system:
            root_directory: /var/lib/pterodactyl
            data: /srv/daemon-data
            archive_directory: /var/lib/pterodactyl/archives
            backup_directory: /var/lib/pterodactyl/backups
            tmp_directory: /tmp/pterodactyl
            username: pterodactyl
            timezone: UTC
            sftp:
              bind_address: 0.0.0.0
              bind_port: 2022
              read_only: false

          docker:
            network:
              interface: pterodactyl_nw

          remote: "http://127.0.0.1"
          debug: false
          app_name: Pterodactyl

          allowed_mounts: []
          allowed_origins:
            - "*"
          ignore_panel_config_updates: true
          YML
          sudo chmod 600 /etc/pterodactyl/config.yml

          echo -e "${C_YELLOW}[INFO] Ensuring docker network pterodactyl_nw...${C_NC}"
          sudo docker network create pterodactyl_nw 2>/dev/null || true

          echo -e "${C_YELLOW}[INFO] Installing wings binary...${C_NC}"
          sudo wget -q https://github.com/pterodactyl/wings/releases/latest/download/wings_linux_amd64 -O /usr/local/bin/wings
          sudo chmod +x /usr/local/bin/wings
          /usr/local/bin/wings --version 2>/dev/null || ls -l /usr/local/bin/wings

          echo -e "${C_YELLOW}[INFO] Creating wings.service...${C_NC}"
          sudo tee /etc/systemd/system/wings.service >/dev/null <<'UNIT'
          [Unit]
          Description=Pterodactyl Wings Daemon
          After=docker.service
          Requires=docker.service
          PartOf=docker.service

          [Service]
          User=root
          WorkingDirectory=/etc/pterodactyl
          LimitNOFILE=4096
          ExecStart=/usr/local/bin/wings
          Restart=on-failure
          RestartSec=5s

          [Install]
          WantedBy=multi-user.target
          UNIT
          sudo systemctl daemon-reload
          sudo systemctl enable --now wings
          sleep 6
          systemctl is-active wings
          sudo systemctl status wings --no-pager -n 3 || true
          echo -e "${C_GREEN}[OK] PTERO 4 wings configured.${C_NC}"

      - name: "PTERO 5/6 Node.js Egg + Demo User"
        run: |
          C_CYAN='\033[1;36m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_NC='\033[0m'

          echo ""
          echo "------------------------------------------------------------"
          echo -e "${C_CYAN}[PTERO 5/6] NODE.JS EGG + DEMO USER${C_NC}"
          echo "------------------------------------------------------------"

          echo -e "${C_YELLOW}[INFO] Downloading generic Node.js egg...${C_NC}"
          sudo wget -q https://raw.githubusercontent.com/pelican-eggs/eggs/master/generic/nodejs/egg-node-js-generic.json -O /tmp/egg-nodejs.json
          sudo chown www-data:www-data /tmp/egg-nodejs.json

